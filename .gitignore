# Only the repo-root campaign workflows dir — a bare `workflows/` pattern also
# matched mcp/src/tools/workflows/ and silently ignored every NEW MCP workflow
# file (existing ones stayed tracked; new ones never got committed).
/workflows/
.opencode.env
*.env
# OS metadata. A drive-by PR (#37) once added two of these because nothing
# stopped it. They carry no information for anyone but the machine that made them.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor state. A committed .vscode/mcp.json is not inert: it offers every
# person who opens this repo an MCP server that fetches and runs a package.
# Editor configuration that executes code stays local (PR #38).
.vscode/
.idea/
*.swp
*~

# DarkMoon Web UI
webui/.venv/
webui/__pycache__/
webui/**/__pycache__/
