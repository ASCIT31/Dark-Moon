#!/bin/sh
# naabu resolves host names with its own public resolvers and ignores /etc/resolv.conf, so names only the local
# resolver knows (Docker DNS, LAN / split-horizon DNS) fail with « no valid ipv4 or ipv6 targets » (live run 18/11).
# When the caller passes no resolver, use the container's own nameservers. Target- and protocol-agnostic.
for a in "$@"; do case "$a" in -r|--r|-resolvers|--resolvers|-r=*|--r=*|-resolvers=*|--resolvers=*) exec /usr/local/bin/naabu "$@";; esac; done
NS=$(awk '/^nameserver/ && $2 ~ /^[0-9.]+$/ {print $2}' /etc/resolv.conf 2>/dev/null | paste -sd, -)  # IPv4 only
[ -n "$NS" ] && exec /usr/local/bin/naabu -r "$NS" "$@"
exec /usr/local/bin/naabu "$@"
