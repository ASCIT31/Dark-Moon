    ],
    "A.8.15": [
      "SR 2.8"
    ],
    "A.8.16": [
      "SR 6.2"
    ],
    "A.8.20": [
      "SR 5.1"
    ],
    "A.8.21": [
      "SR 5.2"
    ],
    "A.8.22": [
      "SR 5.1"
    ],
    "A.8.24": [
      "SR 4.3"
    ],
    "A.8.25": [
      "SR 3.5"
    ],
    "A.8.26": [
      "SR 3.5"
    ],
    "A.8.28": [
      "SR 3.5"
    ],
    "A.8.29": [
      "SR 3.3"
    ]
  }
}
